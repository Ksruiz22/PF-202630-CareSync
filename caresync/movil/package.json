{
  "name": "caresync-movil",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "description": "App móvil de CareSync: el paciente sigue su tratamiento y recibe los recordatorios del agente de seguimiento.",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 5173",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "prueba": "tsx src/agenda.prueba.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "~0.19.13",
    "roble-client": "3.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
